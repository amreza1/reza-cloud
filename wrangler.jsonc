{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reza-cloud",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3d313b24-0f1b-4b56-aca2-a38ee67228e1","database_name": "web-app0" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "048da1b7a66640abb6e83258d773d3eb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
